<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Fitness Tracker E2E Suite" parallel="none" verbose="2">
    <parameter name="baseUrl" value="http://localhost:3000" />

    <test name="Authentication Tests">
        <classes>
            <class name="com.fittracker.tests.SignInTest" />
        </classes>
    </test>

    <test name="Calendar Tests">
        <classes>
            <class name="com.fittracker.tests.CalendarTest" />
        </classes>
    </test>

    <test name="Body Part &amp; Exercise Tests">
        <classes>
            <class name="com.fittracker.tests.AddBodyPartAndExerciseTest" />
        </classes>
    </test>

    <test name="Workout Tests">
        <classes>
            <class name="com.fittracker.tests.LogWorkoutTest" />
            <class name="com.fittracker.tests.EditWorkoutTest" />
        </classes>
    </test>

    <test name="Routine Tests">
        <classes>
            <class name="com.fittracker.tests.CreateRoutineTest" />
        </classes>
    </test>
</suite>
